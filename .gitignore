## Don't Save Secrets That pertain to Secure details
.secrets.yml
vault.yml
## Don't Save Log Files
*.log
support-bundle.zip
.claude
# Don't Include Vagrant support files
.vagrant
id_rsa
# Anchored: only the root working copy — examples/Hosts.yml IS committed
# (the catalog's gold.example_hosts rule reads it from the release archive)
/Hosts.yml
results.yml

# The core_provisioner driver is fetched at build/bootstrap from the release
# pinned in driver.version — never committed. Its ssls/ subtree is the
# canonical SSL location (synced to /secure/; BYO certs drop in there too).
driver/

# Role collections are fetched at build from the releases pinned in
# collections/*.version — no longer submodules, never committed.
provisioners/ansible_collections/
templates/auto-SHI-Hosts.yml
DeployKey_rsa
*.vdi
vault-Docova.yml

*.IDS
*.ID
*.id
*.ids
SAFE.IDS

# Build Files to Ignore
.DS_Store
*.swp
.classpath
.project
.vscode/
.settings/
.gradle/
build/
test_files/

